# Copy to .env and export, or set these in your host's dashboard.
PORT=3000
DATA_DIR=./data
TIMEZONE=America/New_York
LAUNCH_DATE=2026-11-15

# Required only for the daily content refill.
ANTHROPIC_API_KEY=
AUTO_REFILL=0
MAX_API_CALLS_PER_RUN=40
# GENERATE_MODEL=claude-sonnet-5-5
# VERIFY_MODEL=claude-haiku-4-5

# Enables /api/admin/*. Use a long random string.
ADMIN_TOKEN=

# Set to 1 when running behind a proxy (Fly.io, Railway, nginx).
TRUST_PROXY=0
