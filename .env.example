# Node 24+. DATABASE_URL selects shared PostgreSQL; otherwise local SQLite.
PORT=3000
DATA_DIR=./data
# Only for a single production instance with a genuinely persistent volume:
# ALLOW_SQLITE_IN_PRODUCTION=1
# DATABASE_URL=postgresql://user:password@host:5432/downstack?sslmode=verify-full
DB_POOL_SIZE=10
TIMEZONE=America/New_York
LAUNCH_DATE=2026-11-15
QUESTION_SECONDS=25
QUESTIONS_PER_DAY=7
RATE_LIMIT_PER_MIN=120
# Production is HTTPS; set this to your exact browser origin if needed.
# PUBLIC_ORIGIN=https://your-game.example
# Trust only the number of proxy hops actually guaranteed by your host.
TRUST_PROXY_HOPS=0
# Raw submissions, reports, round state and leaderboards are retained this long.
RETENTION_DAYS=90
# Optional owner-only reports API. Use a long random value and never send it to clients.
# ADMIN_TOKEN=
